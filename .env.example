# Copy to .env and fill in.  Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Which Gemini model the ADK agent uses.
# gemini-2.5-flash  — fast, cheap, best for a live demo (default)
# gemini-2.5-pro    — slower, better at long multi-step reasoning
MODEL=gemini-2.5-flash

PORT=8000

# Optional: load only some tool modules, to narrow the agent for a specific demo.
# Leave blank for all of them.
# TOOL_MODULES=accounts,cards,disputes,servicing,knowledge
