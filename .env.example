# Copy to .env and fill in.
# Gemini key — set ONE of these.
#   VERTEX_AI_KEY  — Vertex AI express-mode API key (takes precedence if set)
#   GOOGLE_API_KEY — AI Studio key, https://aistudio.google.com/apikey
VERTEX_AI_KEY=
GOOGLE_API_KEY=

# Which Gemini model the ADK agent uses.
# gemini-2.5-flash  — fast, cheap, best for a live demo (default)
# gemini-2.5-pro    — slower, better at long multi-step reasoning
MODEL=gemini-2.5-flash

PORT=8000

# Optional: load only some tool modules, to narrow the agent for a specific demo.
# Leave blank for all of them.
# TOOL_MODULES=accounts,cards,disputes,servicing,knowledge

# Chat engine for the main page.
#   jev — Jev (TypeSafe System One) picks the tool and every argument; Gemini only
#         writes the reply from the tool output. Needs JEV_API_KEY.  (default)
#   adk — the original ADK agent; Gemini does the tool calling itself.
CHAT_ENGINE=jev
JEV_API_KEY=
# JEV_MODEL=jev-latest
# Port for the Jev log viewer (every query's Jev calls, tools and reply).
JEV_LOG_PORT=8001
